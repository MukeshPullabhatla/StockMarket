GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
POLL_INTERVAL_SECONDS=20

# Only for HTTPS deploys (docker-compose.https.yml): your public hostname
DOMAIN=

# AI chat limits (optional; defaults shown)
CHAT_LIMIT_PER_HOUR=15
CHAT_LIMIT_PER_DAY=50
CHAT_LIMIT_SITE_PER_DAY=500

# Secret for editing the shared default watchlist via the API (empty = edits disabled)
ADMIN_KEY=

# Optional: old hostnames that should redirect to DOMAIN (space-separated)
REDIRECT_FROM=

# Voice mode: server-side speech-to-text (optional; defaults shown)
GROQ_STT_MODEL=whisper-large-v3-turbo
TRANSCRIBE_LIMIT_PER_HOUR=20
TRANSCRIBE_LIMIT_PER_DAY=60
TRANSCRIBE_LIMIT_SITE_PER_DAY=600
